# Copy this file to .env and replace mock values.
# Keep real .env files private. Pushable defaults live in master_config.py.

# Local database secret. The default local value still works if you do not set it.
POSTGRES_PASSWORD=mock-local-postgres-password

# ClearML SDK credentials. Local compose can use mock values; replace for ClearML Cloud or shared servers.
CLEARML_API_ACCESS_KEY=mock-clearml-access-key
CLEARML_API_SECRET_KEY=mock-clearml-secret-key

# LLM provider credentials. Fill only the providers you use.
OPENAI_API_KEY=sk-mock-openai-key
AZURE_OPENAI_API_KEY=mock-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://mock-resource.openai.azure.com
HF_TOKEN=hf_mock_huggingface_token

# Cloud account and CI identity identifiers.
GCP_PROJECT_ID=mock-gcp-project-id
AWS_ROLE_TO_ASSUME=arn:aws:iam::123456789012:role/mock-github-actions-deploy
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/123456789/locations/global/workloadIdentityPools/mock-pool/providers/mock-provider
GCP_SERVICE_ACCOUNT=github-actions@mock-gcp-project-id.iam.gserviceaccount.com

# Managed cloud resource secrets or private account resources.
CHAT_DB_PASSWORD=mock-managed-postgres-password
CONTAINER_IMAGE=mock-registry.example.com/ml-ecommerce-chatbot-api:latest
MODEL_IMAGE=mock-registry.example.com/ml-ecommerce-chatbot-model:latest
MODEL_DATA_URL=s3://mock-ml-ecommerce-artifacts/model/model.tar.gz
AZURE_ML_MODEL_ID=azureml:mock-product-category-model:1
AZURE_ML_ENVIRONMENT_ID=azureml:mock-product-category-env:1
AZURE_ML_SCORING_URI=https://mock-azure-ml-endpoint.westeurope.inference.ml.azure.com/score
AZURE_ML_API_KEY=mock-azure-ml-endpoint-key
GCP_MODEL_ARTIFACT_URI=gs://mock-ml-ecommerce-artifacts/model/
GCP_MODEL_SERVING_IMAGE=europe-west4-docker.pkg.dev/mock-gcp-project-id/ml-ecommerce/model-server:latest
BEDROCK_ROLE_ARN=arn:aws:iam::123456789012:role/mock-bedrock-customization
BEDROCK_OUTPUT_S3_URI=s3://mock-ml-ecommerce-artifacts/bedrock-finetuning-output/

# Terraform remote state locations for your own cloud accounts.
TF_STATE_BUCKET=mock-terraform-state-bucket
TF_STATE_RESOURCE_GROUP=mock-terraform-state-rg
TF_STATE_STORAGE_ACCOUNT=mocktfstateacct
TF_STATE_CONTAINER=tfstate
